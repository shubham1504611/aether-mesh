# AETHER-MESH Environment Matrix Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Security & Authentication Secrets
JWT_SECRET=aether_mesh_secure_production_secret_key_2026

# Regional Node Identification
LOCAL_REGION=us-east-1
LOCAL_NODE_ID=node-us-east

# P2C & PEWMA Hyperparameters
PEWMA_BASE_ALPHA=0.25
PEWMA_BETA=0.15
QUEUE_DEPTH_WEIGHT=0.15

# Rate Limiting Sliding Window Capacity
FREE_TIER_CAPACITY=20
PRO_TIER_CAPACITY=100
ENTERPRISE_TIER_CAPACITY=1000

# Storage & Caching
L1_CACHE_CAPACITY=10000
L2_SHARD_COUNT=16
